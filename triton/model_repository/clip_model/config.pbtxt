name: "clip_model"
platform: "onnxruntime_onnx"

max_batch_size: 4

dynamic_batching {
  preferred_batch_size: [2, 4]
  max_queue_delay_microseconds: 100000
}

input [
  {
    name: "pixel_values"
    data_type: TYPE_FP32
    dims: [3,224,224]
  }
]
output [
  {
    name: "image_emb"
    data_type: TYPE_FP32
    dims: [-1]
  }
]
